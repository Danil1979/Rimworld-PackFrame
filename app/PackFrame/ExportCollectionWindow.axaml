<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.ExportCollectionWindow"
        Title="Rimworld PackFrame"
        Width="760"
        Height="720"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4">
            <TextBlock x:Name="StepText" Foreground="{DynamicResource SecondaryTextBrush}" />
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold"
                       TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock x:Name="NavigationHint" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ScrollViewer x:Name="RepoPage"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="RepoLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="OpenRepoButton"
                                Grid.Column="1"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="30"
                                Padding="14,5"
                                Click="OnOpenRepoClick" />
                    </Grid>
                    <SelectableTextBlock x:Name="RepoPath"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                            <TextBlock x:Name="PackNameLabel"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <Border Classes="field" MinHeight="34">
                                <TextBox x:Name="PackNameBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         VerticalContentAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="PackDescriptionLabel"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                            <Border Classes="field" MinHeight="58">
                                <TextBox x:Name="PackDescriptionBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="CoverPicker"
                                Theme="{StaticResource FlatButton}"
                                Grid.Column="1"
                                Width="256"
                                Height="144"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnCoverPickerClick">
                            <Panel>
                                <Image x:Name="CoverPreview"
                                       Stretch="Uniform"
                                       Margin="4" />
                                <TextBlock x:Name="CoverPlaceholder"
                                           Text="+"
                                           FontSize="28"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="CoverStatus"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock x:Name="PackVersionLabel" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" />
                        <Border Classes="field" MinHeight="34">
                            <TextBox x:Name="PackVersionBox" Background="Transparent" BorderThickness="0" CornerRadius="0" />
                        </Border>
                        <SelectableTextBlock x:Name="PackRevisionText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PackChangelogLabel" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" />
                        <Border Classes="field" MinHeight="70">
                            <TextBox x:Name="PackChangelogBox" Background="Transparent" BorderThickness="0" CornerRadius="0"
                                     AcceptsReturn="True" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock x:Name="LocalHeader"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <ListBox x:Name="LocalList"
                                     Height="260"
                                     Margin="0,6,0,0"
                                     BorderBrush="{DynamicResource SecondaryBrush}"
                                     BorderThickness="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock x:Name="WorkshopHeader1"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <ListBox x:Name="WorkshopList1"
                                     Height="260"
                                     Margin="0,6,0,0"
                                     BorderBrush="{DynamicResource SecondaryBrush}"
                                     BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="MissingHeader"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <ListBox x:Name="MissingList"
                             Height="54"
                             BorderBrush="{DynamicResource SecondaryBrush}"
                             BorderThickness="1" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SteamPage"
                  IsVisible="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock x:Name="WorkshopHeader2"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="SemiBold" />
                <ListBox x:Name="WorkshopList2"
                         Grid.Row="1"
                         Height="180"
                         Margin="0,8,0,8"
                         BorderBrush="{DynamicResource SecondaryBrush}"
                         BorderThickness="1" />
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock x:Name="CollectionNameLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="CollectionNameBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock x:Name="CollectionDescriptionLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button x:Name="InsertFrameworkLinkButton"
                                Grid.Column="1"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="28"
                                Padding="10,3"
                                Click="OnInsertFrameworkLinkClick" />
                    </Grid>
                    <Border Classes="field" MinHeight="58">
                        <TextBox x:Name="CollectionDescriptionBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
                    <WrapPanel>
                        <Button x:Name="CreateCollectionButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="24,8"
                                Click="OnCreateCollectionClick" />
                        <Button x:Name="OpenCollectionButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="18,8"
                                IsVisible="False"
                                Click="OnOpenCollectionClick" />
                    </WrapPanel>
                    <TextBlock x:Name="PrivateNote"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button x:Name="CancelCreateButton"
                            Grid.Column="1"
                            Classes="footerlink"
                            Content="Cancel"
                            IsVisible="False"
                            Margin="8,0,0,0"
                            Click="OnCancelCreateClick" />
                </Grid>
              </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="GithubPage"
                          IsVisible="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="GithubTokenLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Classes="field" MinHeight="36">
                            <TextBox x:Name="GithubTokenBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CornerRadius="0"
                                     PasswordChar="*"
                                     VerticalContentAlignment="Center" />
                        </Border>
                        <Button x:Name="GetTokenButton"
                                Grid.Column="1"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="36"
                                Padding="18,6"
                                Margin="8,0,0,0"
                                Click="OnGetTokenClick" />
                    </Grid>
                    <TextBlock x:Name="GithubTokenHint"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="GithubDestinationText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="UploadGithubButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="24,8"
                                Click="OnUploadGithubClick" />
                        <Button x:Name="OpenGithubRepoButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="18,8"
                                IsVisible="False"
                                Click="OnOpenGithubRepoClick" />
                    </WrapPanel>
                    <TextBlock x:Name="GithubStatus"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="GiteePage"
                          IsVisible="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="GiteeIntro"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="GiteePathLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold" />
                    <SelectableTextBlock x:Name="GiteePath"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         TextWrapping="Wrap" />

                    <Button x:Name="PackLocalModsButton"
                            Theme="{StaticResource FlatButton}"
                            MinHeight="38"
                            Padding="18,8"
                            HorizontalAlignment="Left"
                            Margin="0,8,0,0"
                            Click="OnPackLocalModsClick" />
                    <TextBlock x:Name="PackLocalModsStatus"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <Button x:Name="OssSettingsButton"
                            Theme="{StaticResource FlatButton}"
                            MinHeight="34"
                            Padding="16,6"
                            HorizontalAlignment="Left"
                            Margin="0,4,0,0"
                            Click="OnOssSettingsClick" />
                    <TextBlock x:Name="OssStatus"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="GiteeTokenLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Classes="field" MinHeight="36">
                            <TextBox x:Name="GiteeTokenBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CornerRadius="0"
                                     PasswordChar="*"
                                     VerticalContentAlignment="Center" />
                        </Border>
                        <Button x:Name="GetGiteeTokenButton"
                                Grid.Column="1"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="36"
                                Padding="18,6"
                                Margin="8,0,0,0"
                                Click="OnGetGiteeTokenClick" />
                    </Grid>
                    <TextBlock x:Name="GiteeTokenHint"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="GiteeRepoNameLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="GiteeRepoNameBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnGiteeRepoNameChanged" />
                    </Border>
                    <TextBlock x:Name="GiteeRepoNormalizedLabel"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock x:Name="GithubRepoDescriptionLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="58">
                        <TextBox x:Name="GithubRepoDescriptionBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                    </Border>

                    <TextBlock x:Name="GithubCollectionUrlLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="GithubCollectionUrlBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 VerticalContentAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="GiteeDestinationText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="UploadGiteeButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="24,8"
                                Click="OnUploadGiteeClick" />
                        <Button x:Name="OpenGiteeRepoButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="18,8"
                                IsVisible="False"
                                Click="OnOpenGiteeRepoClick" />
                    </WrapPanel>
                    <TextBlock x:Name="GiteeStatus"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />

                    <Border Height="1" Background="{DynamicResource SecondaryBrush}" Margin="0,10,0,0" />
                    <Button x:Name="OpenRepoGiteeButton"
                            Theme="{StaticResource FlatButton}"
                            MinHeight="38"
                            Padding="20,8"
                            HorizontalAlignment="Left"
                            Click="OnOpenRepoClick" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="IndexPage"
                          IsVisible="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="IndexIntro"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="IndexRepoLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="IndexRepoUrlBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="IndexGiteeRepoLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="IndexGiteeRepoUrlBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="IndexTokenLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="IndexTokenBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 PasswordChar="*"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="IndexGiteeTokenLabel"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <Border Classes="field" MinHeight="36">
                        <TextBox x:Name="IndexGiteeTokenBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CornerRadius="0"
                                 PasswordChar="*"
                                 VerticalContentAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="IndexHint"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="SubmitIndexButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="24,8"
                                Click="OnSubmitIndexClick" />
                        <Button x:Name="OpenIndexPrButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="18,8"
                                IsVisible="False"
                                Click="OnOpenIndexPrClick" />
                        <Button x:Name="OpenGiteeIndexPrButton" Margin="0,0,8,8"
                                Theme="{StaticResource FlatButton}"
                                MinHeight="38"
                                Padding="18,8"
                                IsVisible="False"
                                Click="OnOpenGiteeIndexPrClick" />
                    </WrapPanel>
                    <TextBlock x:Name="IndexStatus"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" />
                    <Border Height="1" Background="{DynamicResource SecondaryBrush}" Margin="0,10,0,0" />
                    <Button x:Name="OpenRepoIndexButton"
                            Theme="{StaticResource FlatButton}"
                            MinHeight="38"
                            Padding="20,8"
                            HorizontalAlignment="Left"
                            Click="OnOpenRepoClick" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,12,0,0">
            <TextBlock x:Name="OperationNotice"
                       Grid.ColumnSpan="3"
                       IsVisible="False"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <ScrollViewer x:Name="NavigationStatusPanel" Grid.Row="1" Grid.ColumnSpan="3"
                          IsVisible="False" MaxHeight="96" Margin="0,0,0,8"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock x:Name="NavigationStatus" TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
            </ScrollViewer>
            <Button x:Name="BackButton"
                    Grid.Row="2"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="38"
                    Padding="24,8"
                    Click="OnBackClick" />
            <WrapPanel Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right">
                <Button x:Name="ExitButton" Theme="{StaticResource FlatButton}"
                        MinHeight="38" Margin="0,0,8,0" Padding="16,8"
                        Click="OnExitClick" />
                <Button x:Name="NextButton" Theme="{StaticResource FlatButton}"
                        MinHeight="38" Padding="16,8" Click="OnNextClick" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
