<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.RenameWindow"
        Title="Rimworld PackFrame"
        Width="560" Height="340" MinWidth="420" MinHeight="300" CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="NameLabel" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="0,0,8,0">
                <TextBlock x:Name="ScopeText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <StackPanel x:Name="FolderPanel" Spacing="4">
                    <TextBlock x:Name="FolderLabel" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="SemiBold" />
                    <SelectableTextBlock x:Name="FolderText" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Border x:Name="NameField" Classes="field" Height="38" CornerRadius="0">
                    <TextBox x:Name="NameBox" Background="Transparent" BorderThickness="0" CornerRadius="0"
                             VerticalContentAlignment="Center" />
                </Border>
                <TextBlock x:Name="ValidationText" IsVisible="False" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,12,0,0">
            <Button x:Name="LogButton" IsVisible="False" HorizontalAlignment="Left" Theme="{StaticResource FlatButton}"
                    MinHeight="32" Margin="0,4,8,0" Click="OnLogClick" />
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" IsCancel="True" Theme="{StaticResource FlatButton}"
                    MinHeight="32" Margin="0,4,8,0" Click="OnCancelClick" />
            <Button x:Name="ConfirmButton" IsDefault="True" Theme="{StaticResource FlatButton}"
                    MinHeight="32" Margin="0,4,0,0" Click="OnConfirmClick" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
