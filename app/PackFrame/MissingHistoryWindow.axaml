<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.MissingHistoryWindow"
        Title="Rimworld PackFrame"
        Width="1040"
        Height="640"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnClearClick" />
        </Grid>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="StatusText" Grid.Row="2" IsVisible="False"
                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <TextBlock x:Name="LinkStatusText" Grid.Row="3" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,10,0,0" />

        <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="4">
            <Border Classes="field" CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchBox" MinHeight="32" Background="#01000000" BorderThickness="0"
                         Padding="8,4" VerticalContentAlignment="Center" />
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" MinWidth="32" MinHeight="32"
                        Theme="{StaticResource FlatButton}" Margin="4,0,0,0" />
            </Grid>
            </Border>
            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="FilterCountText" Margin="0,0,16,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="SearchHintText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="5"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource SecondaryBrush}">
                    <!-- Width follows the actual items panel after scroll-presenter padding. -->
                    <Border x:Name="RowHeaderContent" HorizontalAlignment="Left" Padding="12,9">
                    <Grid ColumnDefinitions="*,160,130">
                        <TextBlock x:Name="LabelHeader" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="LastMissingHeader" Grid.Column="1" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="12,0,0,0" />
                        <TextBlock x:Name="LinkHeader" Grid.Column="2" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="1">
                    <local:AccessibleModListBox x:Name="Rows" Grid.Row="1" SelectionMode="Single" AutoScrollToSelectedItem="False"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{ReflectionBinding AccessibleName}" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:ModStatusListRow">
                                <Border BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                    <Grid ColumnDefinitions="*,160,130" RowDefinitions="Auto,Auto">
                                        <StackPanel Spacing="3">
                                            <SelectableTextBlock Text="{Binding Snapshot.Label}" FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="{Binding Snapshot.AuthorLabel}" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Snapshot.Author}"
                                                    Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Text="{Binding Snapshot.PackageLabel}" Margin="0,0,6,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <SelectableTextBlock Grid.Column="1" Text="{Binding Snapshot.PackageId}"
                                                    Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Snapshot.LastMissingAt}"
                                            Margin="12,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Column="2" Theme="{StaticResource FlatButton}" Content="{Binding Snapshot.LinkAction}"
                                            IsEnabled="{Binding Snapshot.CanOpenLink}" AutomationProperties.Name="{Binding Snapshot.LinkAccessibleName}"
                                            ToolTip.Tip="{Binding Snapshot.Link}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            MinHeight="32" Padding="10,6" Click="OnOpenLinkClick" />
                                        <SelectableTextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Snapshot.Link}"
                                            Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </local:AccessibleModListBox>
                    <TextBlock x:Name="EmptyText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="RefreshButton" Theme="{StaticResource FlatButton}"
                MinHeight="32" Margin="0,0,8,0" Click="OnRefreshClick" />
        <Button x:Name="FooterCloseButton"
                Theme="{StaticResource FlatButton}"
                MinHeight="32"
                Padding="24,6"
                HorizontalAlignment="Right"
                Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
