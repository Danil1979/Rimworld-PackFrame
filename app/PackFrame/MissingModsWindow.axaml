<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.MissingModsWindow"
        Title="Rimworld PackFrame"
        Width="1040"
        Height="640"
        MinWidth="780"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="HistoryButton"
                    Grid.Column="1"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnHistoryClick" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
            <TextBlock x:Name="SummaryText"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="RefreshNoteText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="LinkStatusText" Grid.Row="2" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,10,0,0" />

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
            <Border Classes="field" CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchBox" MinHeight="32" Background="#01000000" BorderThickness="0"
                         Padding="8,4" VerticalContentAlignment="Center" />
                <Button x:Name="ClearSearchButton" Grid.Column="1" Content="×" MinWidth="32" MinHeight="32"
                        Theme="{StaticResource FlatButton}" Margin="4,0,0,0" />
            </Grid>
            </Border>
            <TextBlock x:Name="SearchHintText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="FilterCountText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource SecondaryBrush}" Padding="12,9">
                    <Grid ColumnDefinitions="2*,1.2*,1.6*,2.2*,1.5*">
                        <TextBlock x:Name="LabelHeader"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="AuthorHeader"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="PackageHeader"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="LinkHeader"
                                   Grid.Column="3"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="StatusHeader"
                                   Grid.Column="4"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListBox x:Name="Rows" Grid.Row="1" SelectionMode="Single" AutoScrollToSelectedItem="False"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{ReflectionBinding AccessibleName}" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModStatusListRow">
                                <Border BorderBrush="{DynamicResource SecondaryBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,9">
                                    <Grid ColumnDefinitions="2*,1.2*,1.6*,2.2*,1.5*">
                                        <SelectableTextBlock Text="{Binding Snapshot.Label}"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             TextWrapping="Wrap"
                                                             Margin="0,0,12,0" />
                                        <SelectableTextBlock Grid.Column="1"
                                                             Text="{Binding Snapshot.Author}"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             TextWrapping="Wrap"
                                                             Margin="0,0,12,0" />
                                        <SelectableTextBlock Grid.Column="2"
                                                             Text="{Binding Snapshot.PackageId}"
                                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                                             TextWrapping="Wrap"
                                                             Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="3" Margin="0,0,12,0" Spacing="6">
                                            <SelectableTextBlock Text="{Binding Snapshot.Link}"
                                                Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                            <Button Theme="{StaticResource FlatButton}" Content="{Binding Snapshot.LinkAction}"
                                                IsEnabled="{Binding Snapshot.CanOpenLink}" AutomationProperties.Name="{Binding Snapshot.LinkAccessibleName}"
                                                ToolTip.Tip="{Binding Snapshot.Link}" HorizontalAlignment="Left" MinHeight="30"
                                                Click="OnOpenLinkClick" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Snapshot.Status}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Grid>
        </Border>

        <Button x:Name="FooterCloseButton"
                Grid.Row="5"
                Theme="{StaticResource FlatButton}"
                MinHeight="32"
                Padding="24,6"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="OnCloseClick" />
    </Grid>
</Window>
