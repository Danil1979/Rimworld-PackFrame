<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.ImportModeWindow"
        Title="Rimworld PackFrame"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" RequestedThemeVariant="Dark">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="HintText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <Button x:Name="NewButton" Theme="{StaticResource FlatButton}" MinHeight="40"
                HorizontalAlignment="Stretch" Click="OnNewClick">
            <TextBlock x:Name="NewText" TextWrapping="Wrap" />
        </Button>
        <Button x:Name="OverwriteButton" Theme="{StaticResource FlatButton}" MinHeight="40"
                HorizontalAlignment="Stretch" Click="OnOverwriteClick">
            <TextBlock x:Name="OverwriteText" TextWrapping="Wrap" />
        </Button>
        <TextBlock x:Name="UnavailableText" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
        <Button x:Name="CancelButton" IsCancel="True" Theme="{StaticResource FlatButton}"
                HorizontalAlignment="Right" MinHeight="32" Click="OnCancelClick" />
    </StackPanel>
</Window>
