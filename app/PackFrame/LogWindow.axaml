<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.LogWindow"
        Title="Rimworld PackFrame"
        Width="900"
        Height="600"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="*,Auto">
        <Border BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1"
                Padding="12">
            <ScrollViewer x:Name="LogScroll"
                          HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="LogText"
                                     FontFamily="Consolas,Menlo,Monaco,monospace"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <Button x:Name="OpenLogFileButton"
                Grid.Row="1"
                Theme="{StaticResource FlatButton}"
                MinHeight="32"
                Padding="24,6"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Click="OnOpenLogFileClick" />
    </Grid>
</Window>
