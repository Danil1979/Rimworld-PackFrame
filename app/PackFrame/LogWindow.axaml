<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.LogWindow"
        Title="Rimworld PackFrame"
        Width="900"
        Height="600"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" IsVisible="False" />
        <Border BorderBrush="{StaticResource SecondaryBrush}"
                Grid.Row="1"
                BorderThickness="1"
                Padding="12">
            <ScrollViewer x:Name="LogScroll"
                          HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="LogText"
                                     FontFamily="Consolas,Menlo,Monaco,monospace"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button x:Name="RefreshButton" Theme="{StaticResource FlatButton}" MinHeight="32"
                Margin="0,4,8,0" Click="OnRefreshClick" />
        <Button x:Name="OpenLogFileButton"
                Theme="{StaticResource FlatButton}"
                MinHeight="32"
                Padding="24,6"
                Margin="0,4,8,0"
                HorizontalAlignment="Right"
                Click="OnOpenLogFileClick" />
        <Button x:Name="CloseButton" Theme="{StaticResource FlatButton}" MinHeight="32"
                Margin="0,4,0,0" IsCancel="True" Click="OnCloseClick" />
        </WrapPanel>
    </Grid>
</Window>
