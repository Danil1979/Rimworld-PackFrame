<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.ColorPaletteWindow"
        Title="Rimworld PackFrame"
        Width="840"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="HintText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PalettePanel"
                       ItemWidth="142"
                       ItemHeight="72" />
        </ScrollViewer>
        <Border x:Name="ErrorBorder" Grid.Row="3" Margin="0,8,0,0" Padding="8"
                BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1" IsVisible="False">
            <ScrollViewer MaxHeight="90" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock x:Name="ErrorText" TextWrapping="Wrap"
                                     Foreground="{DynamicResource PrimaryTextBrush}" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="ClearButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnClearClick" />
            <Button x:Name="CancelButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
