<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.MainWindow"
        Title="Rimworld PackFrame"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Window.Resources>
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <Thickness x:Key="ExpanderHeaderPadding">0,8</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0,8</Thickness>
        <DataTemplate x:Key="InstanceNameTemplate">
            <TextBlock Text="{ReflectionBinding}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" MaxWidth="480" />
        </DataTemplate>
        <DataTemplate x:Key="PendingInstanceTemplate" x:DataType="local:PendingInstanceRow">
            <Border BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="0,0,0,1"
                    Padding="0,8">
                <StackPanel Spacing="4">
                    <SelectableTextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding ConfigDirectoryPath}" FontSize="12"
                                         Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ModTemplate" x:DataType="local:ModInfo">
            <Border Background="{Binding RowBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" Opacity="{Binding SearchOpacity}">
                    <TextBlock Text="{Binding LoadOrderText}"
                               IsVisible="{Binding HasLoadOrder}"
                               Width="{Binding LoadOrderGutterWidth}"
                               Margin="0,0,8,0"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Grid.Column="2"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            ToolTip.ShowDelay="200"
                            PointerEntered="OnModBadgePointerEntered"
                            PointerExited="OnModBadgePointerExited">
                        <local:ModBadge Badges="{Binding ActiveBadges}"
                                        Width="22"
                                        Height="22" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Effect="{Binding NameEffect}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.ShowDelay="200"
                               ToolTip.Tip="{Binding ColorLabel}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ComboBox.instance-selector ComboBoxItem">
            <Setter Property="ToolTip.Tip" Value="{ReflectionBinding}" />
        </Style>
        <Style Selector="Button.summary-filter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style Selector="Button.summary-filter.filtered">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.save-action.primary-action">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#102523" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.save-action.primary-action:pointerover">
            <Setter Property="Background" Value="#85D9C9" />
        </Style>
        <Style Selector="Button.secondary-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}" />
        </Style>
        <Style Selector="GridSplitter:pointerover, GridSplitter:focus-visible">
            <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
        </Style>
        <Style Selector="Border.pane-header Border.header-tint">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.pane-header.enable-target Border.header-tint">
            <Setter Property="Opacity" Value="0.08" />
        </Style>
        <Style Selector="ListBox.modpane:not(.pane-active) ListBoxItem:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.modpane:not(.pane-active) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="5" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                <TextBlock Text="PackFrame" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                <Button x:Name="GameFolderToggle" Theme="{StaticResource FlatButton}" Classes="quiet" MinHeight="34" Padding="10,6" Click="OnGameFolderToggleClick" />
            </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="6">
            <Button x:Name="ModDetailsToggle" Theme="{StaticResource FlatButton}" MinHeight="32" Padding="10,6" Click="OnModDetailsToggleClick" />
            <Button x:Name="PaintModeButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="10,6"
                    Click="OnPaintModeClick" />
            <Button x:Name="UndoButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="10,6"
                    Click="OnUndoClick" />
            <Button x:Name="RedoButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="10,6"
                    Click="OnRedoClick" />
            <Button x:Name="SyncConfigButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="10,6"
                    IsVisible="False"
                    Click="OnSyncConfigClick" />
            <Button x:Name="RefreshButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="10,6"
                    Click="OnRefreshClick" />
            <Button x:Name="LanguageButton"

                    Theme="{StaticResource FlatButton}"
                    Content="文/A"
                    Padding="10,8"
                    MinWidth="50"
                    MinHeight="36"
                    Margin="8,0,0,0" />
        </StackPanel>
        </Grid>
        <Border x:Name="GameFolderPanel" Grid.Row="1" IsVisible="False" Background="{DynamicResource PaneSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,12">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Top">
            <TextBlock x:Name="GamePathLabel"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <Border x:Name="PathField"
                    Grid.Column="1"
                    Classes="field"
                    CornerRadius="0"
                    MinHeight="36">
                <TextBox x:Name="PathBox"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Stretch" />
            </Border>
            <Button x:Name="AutoDetectGameButton"
                    Grid.Column="2"
                    Theme="{StaticResource FlatButton}"
                    Margin="12,0,0,0"
                    MinHeight="36"
                    Click="OnAutoDetectGameClick" />
            <Button x:Name="BrowseButton"
                    Grid.Column="3"
                    Theme="{StaticResource FlatButton}"
                    Margin="8,0,0,0"
                    MinHeight="36" />
        </Grid>

        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="630" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DetailsPanel" Grid.Column="0"
                    CornerRadius="6" Background="{DynamicResource PaneSurfaceBrush}"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1"
                    Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock x:Name="DetailsHeading" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="4,2,4,16" />
                    <ScrollViewer Grid.Row="1" x:Name="DetailsEmptyState" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="4,8">
                            <TextBlock x:Name="DetailsEmptyTitle" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailsEmptyBody" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="22" />
                            <TextBlock x:Name="DetailsWorkflow" IsVisible="False" />
                            <TextBlock x:Name="DetailsSelectionHint" IsVisible="False" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" x:Name="DetailsContent" IsVisible="False">
                      <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                       <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <Image x:Name="PreviewImage" MaxHeight="170" IsVisible="False" Stretch="Uniform" HorizontalAlignment="Center" />
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <SelectableTextBlock x:Name="NameLabel" IsVisible="False" />
                            <SelectableTextBlock x:Name="NameValue" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,8,0,12">
                            <SelectableTextBlock x:Name="AuthorLabel" IsVisible="False" />
                            <SelectableTextBlock x:Name="AuthorValue" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Expander x:Name="TechnicalDetails" Foreground="{DynamicResource PrimaryTextBrush}" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <StackPanel Spacing="6">
                                <SelectableTextBlock x:Name="PackageLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                                <SelectableTextBlock x:Name="PackageValue" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                <SelectableTextBlock x:Name="PathLabel" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0" />
                                <SelectableTextBlock x:Name="PathValue" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <SelectableTextBlock x:Name="DescriptionLabel" Grid.Row="4" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8" />
                        <SelectableTextBlock Grid.Row="5" x:Name="DescriptionValue" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" LineHeight="22" />
                       </Grid>
                      </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch"
                          Background="Transparent" Focusable="True">
                <GridSplitter.Template>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}">
                            <Border Width="1" Background="{DynamicResource SecondaryBrush}" Margin="0,12" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Grid x:Name="ManagerColumns" Grid.Column="2" ColumnDefinitions="*,8,*,8,*">
                <Border Grid.Column="0"
                        Background="{DynamicResource PaneSurfaceBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Grid RowDefinitions="26,36,32,24" Margin="2,0,2,4">
                            <TextBlock x:Name="AvailableHeading" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock x:Name="AvailableSubtitle" Grid.Row="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                                <Button x:Name="InactiveSortButton" Theme="{StaticResource FlatButton}" Classes="quiet" MinHeight="28" Padding="6,2" Click="OnInactiveSortClick" />
                            </Grid>
                            <TextBlock x:Name="InactiveHeader" Grid.Row="3" Margin="2,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="1" RowDefinitions="32,30" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2,0,4">
                            <Border Grid.ColumnSpan="4" Classes="field" Height="30" CornerRadius="0">
                                <Grid ColumnDefinitions="*,Auto,28">
                                    <Border MinWidth="0" ClipToBounds="True">
                                        <TextBox x:Name="InactiveSearchBox" Background="#01000000" BorderThickness="0"
                                                 MinWidth="0" ClipToBounds="True" HorizontalAlignment="Stretch"
                                                 CornerRadius="0" Padding="8,4" VerticalContentAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="SearchShortcutHint0" Grid.Column="1" FontSize="11"
                                               Margin="2,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Button x:Name="ClearPaneFilters0" Grid.Column="2" Tag="0" Content="×"
                                            Theme="{StaticResource FlatButton}" Padding="0" FontSize="18"
                                            Click="OnResetPaneFiltersClick" />
                                </Grid>
                            </Border>
                            <ComboBox x:Name="InactiveSearchField" Grid.Row="1" MinWidth="0"
                                      HorizontalAlignment="Stretch" MinHeight="26" Height="26" Padding="6,3" />
                            <Button x:Name="InactiveSourceButton" Grid.Row="1" Grid.Column="1"
                                    Theme="{StaticResource FlatButton}" MinWidth="48" MinHeight="26"
                                    Height="26" Padding="6,2" Margin="4,0,0,0" Click="OnInactiveSourceClick" />
                            <Button x:Name="InactiveViewModeButton" Grid.Row="1" Grid.Column="2"
                                    Theme="{StaticResource FlatButton}" Width="26" MinWidth="26" MinHeight="26"
                                    Height="26" Padding="0" Margin="4,0,0,0" Click="OnInactiveViewModeClick" />
                        </Grid>
                        <Grid Grid.Row="2" RowDefinitions="38,*">
                            <TextBlock x:Name="InactiveActionHint" Height="38" FontSize="12" Margin="2,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <local:AccessibleModListBox Grid.Row="1" x:Name="InactiveList"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"

                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </local:AccessibleModListBox>
                        <Border Grid.Row="1" x:Name="PaneEmpty0" IsVisible="False" Margin="10,26" VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PaneEmptyTitle0" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PaneEmptyBody0" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="0,1,0,0" Padding="0,6,0,0" MinHeight="38">
                            <StackPanel>
                            <WrapPanel>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="InactiveProblemV" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="InactiveProblemR" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="InactiveLocalCount" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                            </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ActiveColumn1"
                        Grid.Column="2"
                        Background="{DynamicResource PaneSurfaceBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Border x:Name="ActivePaneHeader1" Classes="pane-header"
                                Grid.Row="0" Margin="0,0,0,4">
                          <Grid>
                            <Border Classes="header-tint"
                                    Background="{DynamicResource PrimaryTextBrush}"
                                    IsHitTestVisible="False" />
                            <Grid RowDefinitions="26,36,32,24" Margin="2,0,2,0">
                            <TextBlock x:Name="LoadOrderHeading1" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                                <ComboBox x:Name="InstanceCombo1"
                                          Classes="instance-selector"
                                          MinWidth="0"
                                          ItemTemplate="{StaticResource InstanceNameTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnInstanceSelectionChanged" />
                                <Border x:Name="SameListBadge1"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" />
                                </Border>
                                <Button x:Name="SplitViewButton"
                                        Grid.Column="2"
                                        Theme="{StaticResource FlatButton}"
                                        MinHeight="28"
                                        Padding="6,4"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnSplitViewClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource PrimaryTextBrush}"
                                              StrokeThickness="1.25"
                                              Data="M 1,1 L 13,1 L 13,13 L 1,13 Z M 7,1 L 7,13" />
                                        <TextBlock x:Name="SplitViewLabel"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                                <Button x:Name="InstanceActionButton1"
                                        Theme="{StaticResource FlatButton}"
                                        Content="…"
                                        Padding="8,4"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Click="OnInstanceActionsClick" />
                                <Button x:Name="ModpackButton1"
                                        Grid.Column="1"
                                        Theme="{StaticResource FlatButton}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="OnModpack1Click" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,0">
                                <TextBlock x:Name="ActiveHeader1" Grid.Column="0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" FontSize="12" />
                                <Border x:Name="PendingBadge1" Grid.Column="1" Margin="8,0,0,0"
                                        Background="{DynamicResource PendingSurfaceBrush}" CornerRadius="3" Padding="5,1" IsVisible="False"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PendingLabel1" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Border>
                            </Grid>
                            </Grid>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1" RowDefinitions="32,30" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2,0,4">
                            <Border Grid.ColumnSpan="4" Classes="field" Height="30" CornerRadius="0">
                                <Grid ColumnDefinitions="*,Auto,28">
                                    <Border MinWidth="0" ClipToBounds="True">
                                        <TextBox x:Name="ActiveSearchBox1" Background="#01000000" BorderThickness="0"
                                                 MinWidth="0" ClipToBounds="True" HorizontalAlignment="Stretch"
                                                 CornerRadius="0" Padding="8,4" VerticalContentAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="SearchShortcutHint1" Grid.Column="1" FontSize="11"
                                               Margin="2,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Button x:Name="ClearPaneFilters1" Grid.Column="2" Tag="1" Content="×"
                                            Theme="{StaticResource FlatButton}" Padding="0" FontSize="18"
                                            Click="OnResetPaneFiltersClick" />
                                </Grid>
                            </Border>
                            <ComboBox x:Name="ActiveSearchField1" Grid.Row="1" MinWidth="0"
                                      HorizontalAlignment="Stretch" MinHeight="26" Height="26" Padding="6,3" />
                            <Button x:Name="ActiveSourceButton1" Grid.Row="1" Grid.Column="1"
                                    Theme="{StaticResource FlatButton}" MinWidth="48" MinHeight="26"
                                    Height="26" Padding="6,2" Margin="4,0,0,0" Click="OnActiveSource1Click" />
                            <Button x:Name="ActiveViewModeButton1" Grid.Row="1" Grid.Column="2"
                                    Theme="{StaticResource FlatButton}" Width="26" MinWidth="26" MinHeight="26"
                                    Height="26" Padding="0" Margin="4,0,0,0" Click="OnActiveViewMode1Click" />
                        </Grid>
                        <Grid Grid.Row="2" RowDefinitions="72,*">
                            <Grid Height="72" RowDefinitions="0,72">
                                <TextBlock x:Name="PaneActionTarget1" IsVisible="False" Margin="2,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="38,34">
                                    <Button x:Name="EnableSelection1" Tag="0:1" Margin="0,0,3,4"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Click="OnSelectionActionClick" />
                                    <Button x:Name="DisableSelection1" Grid.Column="1" Tag="1:0" Margin="3,0,0,4"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Click="OnSelectionActionClick" />
                                    <Button x:Name="MoveUp1" Grid.Row="1" Tag="1:-1" Content="↑"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Margin="0,0,3,4" Click="OnReorderClick" />
                                    <Button x:Name="MoveDown1" Grid.Row="1" Grid.Column="1" Tag="1:1" Content="↓"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Margin="3,0,0,4" Click="OnReorderClick" />
                                </Grid>
                            </Grid>
                        <local:AccessibleModListBox Grid.Row="1" x:Name="ActiveList1"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"

                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </local:AccessibleModListBox>
                        <Border Grid.Row="1" x:Name="PaneEmpty1" IsVisible="False" Margin="10,26" VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PaneEmptyTitle1" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PaneEmptyBody1" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="0,1,0,0" Padding="0,6,0,0" MinHeight="38">
                            <StackPanel>
                            <WrapPanel>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemS1" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemV1" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemR1" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveLocalCount1" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                            </WrapPanel>
                            <Button x:Name="ActiveMissing1" Classes="footerlink" IsVisible="False"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Margin="2,3,0,0" Click="OnMissing1Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="ActiveColumn2"
                        Grid.Column="4"
                        Background="{DynamicResource PaneSurfaceBrush}"
                        CornerRadius="6" BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <Border x:Name="ActivePaneHeader2" Classes="pane-header"
                                Grid.Row="0" Margin="0,0,0,4">
                          <Grid>
                            <Border Classes="header-tint"
                                    Background="{DynamicResource PrimaryTextBrush}"
                                    IsHitTestVisible="False" />
                            <Grid RowDefinitions="26,36,32,24" Margin="2,0,2,0">
                            <TextBlock x:Name="LoadOrderHeading2" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                                <ComboBox x:Name="InstanceCombo2"
                                          Classes="instance-selector"
                                          MinWidth="0"
                                          ItemTemplate="{StaticResource InstanceNameTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnInstanceSelectionChanged" />
                                <Border x:Name="SameListBadge2"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" />
                                </Border>
                                <Button x:Name="CloseSecondaryPaneButton"
                                        Grid.Column="2"
                                        Theme="{StaticResource FlatButton}"
                                        Width="28" Height="28"
                                        Padding="7"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnCloseSecondaryPaneClick">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="1.5"
                                          Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*">
                                <Button x:Name="InstanceActionButton2"
                                        Theme="{StaticResource FlatButton}"
                                        Content="…"
                                        Padding="8,4"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Click="OnInstanceActionsClick" />
                                <Button x:Name="ModpackButton2"
                                        Grid.Column="1"
                                        Theme="{StaticResource FlatButton}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="OnModpack2Click" />
                            </Grid>
                            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="2,0">
                                <TextBlock x:Name="ActiveHeader2" Grid.Column="0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center" FontSize="12" />
                                <Border x:Name="PendingBadge2" Grid.Column="1" Margin="8,0,0,0"
                                        Background="{DynamicResource PendingSurfaceBrush}" CornerRadius="3" Padding="5,1" IsVisible="False"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="PendingLabel2" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Border>
                            </Grid>
                            </Grid>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1" RowDefinitions="32,30" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2,0,4">
                            <Border Grid.ColumnSpan="4" Classes="field" Height="30" CornerRadius="0">
                                <Grid ColumnDefinitions="*,Auto,28">
                                    <Border MinWidth="0" ClipToBounds="True">
                                        <TextBox x:Name="ActiveSearchBox2" Background="#01000000" BorderThickness="0"
                                                 MinWidth="0" ClipToBounds="True" HorizontalAlignment="Stretch"
                                                 CornerRadius="0" Padding="8,4" VerticalContentAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="SearchShortcutHint2" Grid.Column="1" FontSize="11"
                                               Margin="2,0,4,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Button x:Name="ClearPaneFilters2" Grid.Column="2" Tag="2" Content="×"
                                            Theme="{StaticResource FlatButton}" Padding="0" FontSize="18"
                                            Click="OnResetPaneFiltersClick" />
                                </Grid>
                            </Border>
                            <ComboBox x:Name="ActiveSearchField2" Grid.Row="1" MinWidth="0"
                                      HorizontalAlignment="Stretch" MinHeight="26" Height="26" Padding="6,3" />
                            <Button x:Name="ActiveSourceButton2" Grid.Row="1" Grid.Column="1"
                                    Theme="{StaticResource FlatButton}" MinWidth="48" MinHeight="26"
                                    Height="26" Padding="6,2" Margin="4,0,0,0" Click="OnActiveSource2Click" />
                            <Button x:Name="ActiveViewModeButton2" Grid.Row="1" Grid.Column="2"
                                    Theme="{StaticResource FlatButton}" Width="26" MinWidth="26" MinHeight="26"
                                    Height="26" Padding="0" Margin="4,0,0,0" Click="OnActiveViewMode2Click" />
                        </Grid>
                        <Grid Grid.Row="2" RowDefinitions="72,*">
                            <Grid Height="72" RowDefinitions="0,72">
                                <TextBlock x:Name="PaneActionTarget2" IsVisible="False" Margin="2,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="38,34">
                                    <Button x:Name="EnableSelection2" Tag="0:2" Margin="0,0,3,4"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Click="OnSelectionActionClick" />
                                    <Button x:Name="DisableSelection2" Grid.Column="1" Tag="2:0" Margin="3,0,0,4"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Click="OnSelectionActionClick" />
                                    <Button x:Name="MoveUp2" Grid.Row="1" Tag="2:-1" Content="↑"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Margin="0,0,3,4" Click="OnReorderClick" />
                                    <Button x:Name="MoveDown2" Grid.Row="1" Grid.Column="1" Tag="2:1" Content="↓"
                                            Theme="{StaticResource FlatButton}" HorizontalAlignment="Stretch" Padding="4,2"
                                            Margin="3,0,0,4" Click="OnReorderClick" />
                                </Grid>
                            </Grid>
                        <local:AccessibleModListBox Grid.Row="1" x:Name="ActiveList2"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"

                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </local:AccessibleModListBox>
                        <Border Grid.Row="1" x:Name="PaneEmpty2" IsVisible="False" Margin="10,26" VerticalAlignment="Top">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="PaneEmptyTitle2" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="PaneEmptyBody2" Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="0,1,0,0" Padding="0,6,0,0" MinHeight="38">
                            <StackPanel>
                            <WrapPanel>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemS2" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemV2" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveProblemR2" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                                <Button Classes="summary-filter" Theme="{StaticResource FlatButton}" Click="OnSummaryFilterClick">
                                    <TextBlock x:Name="ActiveLocalCount2" Foreground="{DynamicResource PrimaryTextBrush}" />
                                </Button>
                            </WrapPanel>
                            <Button x:Name="ActiveMissing2" Classes="footerlink" IsVisible="False"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Margin="2,3,0,0" Click="OnMissing2Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
              Margin="0,8,0,0">
            <Border x:Name="EditStatusBanner" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="10,5" Background="{DynamicResource PendingSurfaceBrush}"
                    BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="EditStatusText" Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="EditRecoveryText" Foreground="{DynamicResource PrimaryTextBrush}"
                                   IsVisible="False" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ReviewPendingInstancesButton" Grid.Column="1" Margin="12,0,0,0"
                            Theme="{StaticResource FlatButton}" MinHeight="28" Padding="8,3"
                            Click="OnReviewPendingInstancesClick" />
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Button x:Name="GithubLinkButton"
                        Classes="footerlink"
                        Click="OnGithubLinkClick" />
                <Button x:Name="DiscordLinkButton"
                        Classes="footerlink"
                        Click="OnDiscordLinkClick" />
                <SelectableTextBlock x:Name="QqGroupText"
                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                     VerticalAlignment="Center" />
                <Button x:Name="BackgroundButton"
                        Classes="footerlink"
                        Click="OnBackgroundClick" />
                <Button x:Name="CheckUpdateButton"
                        Classes="footerlink"
                        Click="OnCheckUpdateClick" />
                <Button x:Name="LogButton"
                        Classes="footerlink"
                        Click="OnLogClick" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="SaveButton" Classes="save-action"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="36"
                        Padding="24,8"
                        Click="OnSaveClick" />
                <Button x:Name="LaunchButton"
                        Classes="secondary-action"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="36"
                        MaxWidth="300"
                        Padding="24,8"
                        IsEnabled="False"
                        Click="OnLaunchClick">
                    <TextBlock x:Name="LaunchTargetText"
                               TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>
        </Grid>

        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Background="Transparent">
            <Border x:Name="DropTargetOutline"
                    BorderBrush="{DynamicResource PrimaryTextBrush}"
                    BorderThickness="2"
                    IsVisible="False" />
            <Border x:Name="InsertionLine"
                    Height="2"
                    Background="{DynamicResource PrimaryTextBrush}"
                    IsVisible="False" />
            <Border x:Name="DragGhost"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                    BorderThickness="1"
                    Padding="10,6"
                    Width="240"
                    IsVisible="False">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DragGhostAction"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="False" />
                    <TextBlock x:Name="DragGhostText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           MaxHeight="100"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="UndoToast"
                Grid.RowSpan="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                Background="#CC20354A"
                BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1"
                Padding="12,8"
                IsVisible="False">
            <TextBlock x:Name="UndoToastText"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
        </Border>
    </Grid>
</Window>


