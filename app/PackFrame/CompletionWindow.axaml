<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.CompletionWindow"
        Title="Rimworld PackFrame"
        Width="560"
        SizeToContent="Height"
        MinHeight="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,20,0,0">
            <Button x:Name="MissingButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnMissingClick" />
            <Button x:Name="OpenFolderButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnOpenFolderClick" />
            <Button x:Name="CloseButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
