<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.ModpackWindow"
        Title="Rimworld PackFrame"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnRefreshClick" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              Margin="0,10,0,0">
            <TextBlock x:Name="RepoLabel"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Border Grid.Column="1"
                    Classes="field"
                    MinHeight="32"
                    CornerRadius="0">
                <TextBox x:Name="RepoBox"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         VerticalContentAlignment="Center"
                         KeyDown="OnRepoKeyDown" />
            </Border>
            <Button x:Name="RepoMenuButton"
                    Grid.Column="2"
                    Theme="{StaticResource FlatButton}"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="4,0,0,0"
                    Content="▾"
                    Click="OnRepoMenuClick" />
            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                    Background="{DynamicResource SecondaryBrush}" Padding="10,8">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CatalogStatusText"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap" />
                    <Expander x:Name="CatalogErrorDetails" IsVisible="False"
                              HorizontalAlignment="Stretch">
                        <ScrollViewer MaxHeight="100" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock x:Name="CatalogErrorText"
                                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                                 TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="2*,12,3*"
              Margin="0,12,0,0">
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource SecondaryBrush}" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ListHeader"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ListCount"
                                       Grid.Column="1"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="PackList"
                             Grid.Row="1"
                             ItemContainerTheme="{StaticResource ModListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnPackSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModpackListItem">
                                <StackPanel Margin="4,6">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Name}" />
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1"
                    Padding="12">
                <Grid RowDefinitions="*,Auto">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border x:Name="PackNotice" IsVisible="False" Padding="10"
                                Background="{DynamicResource SecondaryBrush}">
                            <TextBlock x:Name="PackNoticeText"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <SelectableTextBlock x:Name="PackTitle"
                                             FontSize="21"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="Wrap" />
                        <SelectableTextBlock x:Name="PackMeta"
                                             Foreground="{DynamicResource SecondaryTextBrush}"
                                             TextWrapping="Wrap" />

                        <Border x:Name="CoverContainer" IsVisible="False" MaxHeight="200"
                                Background="{DynamicResource AppBackgroundBrush}"
                                HorizontalAlignment="Stretch">
                            <Image x:Name="CoverImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>

                        <SelectableTextBlock x:Name="PackDescription"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="Wrap" />
                        <Border x:Name="ModsSection" IsVisible="False" BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ModsHeader"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="EmptyModsText"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           IsVisible="False" />
                                <ItemsControl x:Name="ModList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModpackModRow">
                                            <Border BorderBrush="{DynamicResource SecondaryBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                                               Text="{Binding Detail}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,3,0,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding GameVersion}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               MaxWidth="120" TextWrapping="Wrap"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="LinkSection" IsVisible="False" BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="LinkLabel"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Border Classes="field"
                                            MinHeight="32"
                                            CornerRadius="0">
                                        <TextBox x:Name="LinkBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 CornerRadius="0"
                                                 VerticalContentAlignment="Center" />
                                    </Border>
                                    <Button x:Name="OpenWorkshopButton"
                                            Grid.Column="1"
                                            Theme="{StaticResource FlatButton}"
                                            MinHeight="32"
                                            MinWidth="120"
                                            Padding="18,4"
                                            Margin="8,0,0,0"
                                            Click="OnOpenWorkshopClick" />
                                </Grid>

                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdateVersionText" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button x:Name="CheckUpdateButton" Theme="{StaticResource FlatButton}" Margin="0,4,8,0" Click="OnCheckUpdateClick" />
                            <Button x:Name="BindPackButton" Theme="{StaticResource FlatButton}" Margin="0,4,8,0" Click="OnBindPackClick" />
                            <Button x:Name="RestoreUpdateButton" Theme="{StaticResource FlatButton}" Margin="0,4,8,0" Click="OnRestoreUpdateClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="1" BorderBrush="{DynamicResource SecondaryBrush}"
                        BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button x:Name="InstallButton" MaxWidth="210" Margin="0,0,8,6"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="54"
                                    Padding="14,8"
                                    Click="OnInstallClick" />
                            <Button x:Name="SteamCmdButton" MaxWidth="210" Margin="0,0,8,6"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="54"
                                    Padding="14,8"
                                    Click="OnSteamCmdInstallClick" />
                            <Button x:Name="AdvancedOptionsButton" MaxWidth="210" Margin="0,0,8,6"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="54"
                                    Padding="14,8">
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Spacing="8" MaxWidth="380">
                                            <Button x:Name="WorkshopOnlyButton"
                                                    Theme="{StaticResource FlatButton}"
                                                    MinHeight="54"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="16,8"
                                                    Click="OnWorkshopOnlyInstallClick" />
                                            <Button x:Name="ApplyConfigButton"
                                                    Theme="{StaticResource FlatButton}"
                                                    MinHeight="54"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="16,8"
                                                    Click="OnApplyConfigClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </WrapPanel>
                </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,10,0,0">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="8,0,0,0">
                        <Button x:Name="ResumeDownloadButton"
                                Classes="footerlink"
                                FontSize="10"
                                Padding="4,2"
                                IsVisible="False"
                                Click="OnResumeDownloadClick" />
                        <Button x:Name="OssFallbackButton"
                                Classes="footerlink"
                                FontSize="10"
                                Padding="4,2"
                                Margin="8,0,0,0"
                                IsVisible="False"
                                Click="OnUseOssClick" />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Button x:Name="CancelOperationButton"
                    Grid.Column="1"
                    Classes="footerlink"
                    Content="Cancel"
                    IsVisible="False"
                    Margin="8,0,0,0"
                    Click="OnCancelOperationClick" />
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="24,6"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>








